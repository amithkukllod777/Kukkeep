{
  "manifest_version": 3,
  "name": "KukKeep Web Clipper",
  "version": "1.0.0",
  "description": "Save the current page, link, or selected text to KukKeep.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://keep.kuklabs.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to KukKeep"
  }
}
